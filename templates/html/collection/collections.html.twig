<div class="flex items-center justify-between gap-4 mb-4">
    {% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
        'url': 'collections',
        'label': 'Collections'|trans
    }], 'disableMargin': true} %}
    {% if isAuthenticated() %}
        {% include 'html/navigation/admin-edit-link.html.twig' with {
            path: 'admin/collections',
            redirectTo: 'collections',
            title: "Manage collections"|trans,
            label: "Manage"|trans({}, 'admin')
        } %}
    {% endif %}
</div>
{% autoescape false %}
    <div class="grid grid-cols-1 gap-4">
        <!-- COLLECTIONS MAP -->
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <h2 class="flex items-center gap-x-1 text-lg font-semibold mb-4">
                {{ svg('route', 'size-5') }}
                <span>{{ "All routes"|trans }}</span>
            </h2>
            {% if leaflet %}
                {% set leafletOptions = {
                    'polylineUrl': relativeUrl(leaflet.polylineUrl),
                    'tileLayer': leaflet.map.getTileLayer(),
                    'minZoom': leaflet.map.getMinZoom(),
                    'maxZoom': leaflet.map.getMaxZoom(),
                    'imageOverlay': leaflet.map.getOverlayImageUrl(),
                    'bounds': leaflet.map.getBounds()
                } %}
                <div class="h-80 md:h-96 w-full z-0 rounded-lg overflow-hidden" data-leaflet='{{ leafletOptions|json_encode }}'></div>
            {% endif %}
        </div>
        <!-- COLLECTIONS -->
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <h2 class="flex items-center gap-x-1 text-lg font-semibold mb-4">
                {{ svg('image', 'size-5') }}
                <span>{{ "Collections"|trans }}</span>
            </h2>
            <div data-dataTable-settings='{"url":"{{ relativeUrl(path('collection_data_table')) }}","name":"collections"}' class="relative">
                <form class="flex flex-col gap-y-2 mb-2" autocomplete="off">
                    <div class="flex items-center">
                        <label for="search" class="sr-only">{{ "Search"|trans }}</label>
                        <div class="relative w-full">
                            <div class="absolute inset-y-0 inset-s-0 flex items-center ps-3 pointer-events-none">
                                <svg class="size-4 text-gray-500" aria-hidden="true"
                                     xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                          stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
                                </svg>
                            </div>
                            <input id="search" type="search" placeholder="{{ "Search collection..."|trans }}"
                                   class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition block w-full ps-10 p-2.5">
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {% if sportTypes|length > 0 %}
                            <div class="filter-dropdown">
                                <button id="dropdownSportTypesButton"
                                        data-dropdown="dropdownSportTypes" data-dropdown-offset-distance="10" data-dropdown-offset-skidding="0" type="button">
                                    <span>{{ "Filter on sport type"|trans }}</span>
                                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
                                    </svg>
                                </button>
                                <div id="dropdownSportTypes" class="divide-y divide-gray-100">
                                    <ul aria-labelledby="dropdownSportTypesButton">
                                        {% for sportType in sportTypes %}
                                            <li>
                                                <div>
                                                    <input type="checkbox" id="{{ sportType.value }}" data-dataTable-filter="sportType" name="sportType[{{ sportType.value }}]" value="{{ sportType.value }}" class="peer" />
                                                    <label for="{{ sportType.value }}" class="flex gap-x-1 items-center">
                                                        {{ svgSportType(sportType) }}
                                                        <div>{{ sportType|trans }}</div>
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="sportType[{{ sportType.value }}]">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endif %}
                        <div class="filter-dropdown">
                            <button id="dropdownDateRangeButton"
                                    data-dropdown="dropdownDateRange" type="button">
                                <span>{{ "Date"|trans }}</span>
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
                                </svg>
                            </button>
                            <div id="dropdownDateRange" class="divide-y divide-gray-100">
                                <div class="flex items-center gap-x-2 p-3" aria-labelledby="dropdownDateRangeButton">
                                    <div class="flex items-center" data-dataTable-filter="start-date[]">
                                        <input name="start-date[from]" type="date" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5">
                                        <span class="mx-2 text-gray-500">{{ "to"|trans }}</span>
                                        <input name="start-date[to]" type="date" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5">
                                    </div>
                                    <a href="#" class="text-primary text-sm text-right underline" data-datatable-filter-clear="start-date">{{ "clear"|trans }}</a>
                                </div>
                                <div class="hidden lg:flex flex-wrap gap-1.5 p-3" data-date-preset-filter="start-date">
                                    <a href="#" data-date-preset="this-week" class="text-xs text-gray-500 hover:text-primary border border-gray-200 hover:border-primary rounded-full px-2.5 py-1">{{ "This week"|trans }}</a>
                                    <a href="#" data-date-preset="last-week" class="text-xs text-gray-500 hover:text-primary border border-gray-200 hover:border-primary rounded-full px-2.5 py-1">{{ "Last week"|trans }}</a>
                                    <a href="#" data-date-preset="this-month" class="text-xs text-gray-500 hover:text-primary border border-gray-200 hover:border-primary rounded-full px-2.5 py-1">{{ "This month"|trans }}</a>
                                    <a href="#" data-date-preset="last-month" class="text-xs text-gray-500 hover:text-primary border border-gray-200 hover:border-primary rounded-full px-2.5 py-1">{{ "Last month"|trans }}</a>
                                    <a href="#" data-date-preset="last-30-days" class="text-xs text-gray-500 hover:text-primary border border-gray-200 hover:border-primary rounded-full px-2.5 py-1">{{ "Last 30 days"|trans }}</a>
                                </div>
                            </div>
                        </div>
                        {% if countries|length > 0 %}
                            <div class="filter-dropdown">
                                <button id="dropdownCountriesButton"
                                        data-dropdown="dropdownCountries" data-dropdown-offset-distance="10" data-dropdown-offset-skidding="0" type="button">
                                    <span>{{ "Country"|trans }}</span>
                                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
                                    </svg>
                                </button>
                                <div id="dropdownCountries" class="divide-y divide-gray-100">
                                    <ul aria-labelledby="dropdownCountriesButton">
                                        {% for countryCode,countryName in countries %}
                                            <li>
                                                <div>
                                                    <input type="radio" id="{{ countryCode }}" data-dataTable-filter="countryCode" name="countryCode" value="{{ countryCode }}" class="peer" />
                                                    <label for="{{ countryCode }}" class="flex gap-x-1 items-center">
                                                        <img src="{{ countryCode|countryIcon }}" width="15" class="rounded-xs" title="{{ countryName }}" alt="{{ countryName }}">
                                                        <span>{{ countryName }}</span>
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="countryCode">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endif %}
                        {% if devices|length > 0 %}
                            <div class="filter-dropdown">
                                <button id="dropdownDevicesButton"
                                        data-dropdown="dropdownDevices" data-dropdown-offset-distance="10" data-dropdown-offset-skidding="0" type="button">
                                    <span>{{ "Device"|trans }}</span>
                                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
                                    </svg>
                                </button>
                                <div id="dropdownDevices" class="divide-y divide-gray-100">
                                    <ul aria-labelledby="dropdownDevicesButton">
                                        {% for device in devices %}
                                            <li>
                                                <div>
                                                    <input type="radio" id="{{ device.getId() }}" data-dataTable-filter="device" name="device" value="{{ device.getId() }}" class="peer" />
                                                    <label for="{{ device.getId() }}">
                                                        <span>{{ device.getName() }}</span>
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="device">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        {% endfor %}
                                        <li>
                                            <div>
                                                <input type="radio" id="recordingDevice-none" data-dataTable-filter="device" name="device" value="recordingDevice-none" class="peer" />
                                                <label for="recordingDevice-none">
                                                    <span>{{ "Unspecified"|trans }}</span>
                                                </label>
                                                <a href="#" data-datatable-filter-clear="device">{{ "clear"|trans }}</a>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        {% endif %}
                        <div class="filter-dropdown">
                            <button id="distanceElevationButton" data-dropdown="dropdownDistanceElevation" data-dropdown-offset-distance="10" data-dropdown-offset-skidding="0" type="button">
                                <span>{{ "Distance & Elevation"|trans }}</span>
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
                                </svg>
                            </button>
                            <div id="dropdownDistanceElevation">
                                <div class="p-3 flex flex-col gap-y-2">
                                    <div class="flex flex-col gap-y-2">
                                        <label for="distance[from]" class="flex gap-x-1 items-center text-sm font-medium text-gray-500">
                                            {{ svg('distance', 'size-4', 'text-gray-500') }}
                                            <span>{{ "Distance"|trans }}</span>
                                        </label>
                                        <div class="group/range-filter flex items-center justify-between gap-x-2">
                                            <div class="flex items-center justify-between w-full" data-dataTable-filter="distance[]">
                                                <div class="flex items-center">
                                                    <input name="distance[from]" type="number" min="0" step="0.1" placeholder="{{ "min"|trans }}" class="z-20 w-23 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-s-lg block p-2.5">
                                                    <span class="flex items-center py-3 px-3 bg-gray-100 text-gray-500 border border-l-0 border-gray-300 text-xs rounded-e-lg">
                                                      {{ renderUnitSymbol('distance') }}
                                                    </span>
                                                </div>
                                                <span class="mx-2 text-gray-500">{{ "to"|trans }}</span>
                                                <div class="flex items-center">
                                                    <input name="distance[to]" type="number" min="0" step="0.1" placeholder="{{ "max"|trans }}" class="z-20 w-23 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-s-lg block p-2.5">
                                                    <span class="flex items-center py-3 px-3 bg-gray-100 text-gray-500 border border-l-0 border-gray-300 text-xs rounded-e-lg">
                                                      {{ renderUnitSymbol('distance') }}
                                                    </span>
                                                </div>
                                            </div>
                                            <a href="#" class="invisible group-has-[input:not(:placeholder-shon)]/range-filter:visible text-primary text-sm text-right underline" data-datatable-filter-clear="distance">{{ "clear"|trans }}</a>
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-y-2">
                                        <label for="elevation[from]" class="flex gap-x-1 items-center text-sm font-medium text-gray-500">
                                            {{ svg('elevation', 'size-4', 'text-gray-500') }}
                                            <span>{{ "Elevation"|trans }}</span>
                                        </label>
                                        <div class="group/range-filter flex items-center justify-between gap-x-2">
                                            <div class="flex items-center justify-between w-full" data-dataTable-filter="elevation[]">
                                                <div class="flex items-center">
                                                    <input name="elevation[from]" type="number" min="0" step="0.1" placeholder="{{ "min"|trans }}" class="z-20 w-23 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-s-lg block p-2.5">
                                                    <span class="flex items-center py-3 px-3 bg-gray-100 text-gray-500 border border-l-0 border-gray-300 text-xs rounded-e-lg">
                                                      {{ renderUnitSymbol('elevation') }}
                                                    </span>
                                                </div>
                                                <span class="mx-2 text-gray-500">{{ "to"|trans }}</span>
                                                <div class="flex items-center">
                                                    <input name="elevation[to]" type="number" min="0" step="0.1" placeholder="{{ "max"|trans }}" class="z-20 w-23 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-s-lg block p-2.5">
                                                    <span class="flex items-center py-3 px-3 bg-gray-100 text-gray-500 border border-l-0 border-gray-300 text-xs rounded-e-lg">
                                                      {{ renderUnitSymbol('elevation') }}
                                                    </span>
                                                </div>
                                            </div>
                                            <a href="#" class="invisible group-has-[input:not(:placeholder-shown)]/range-filter:visible text-primary text-sm text-right underline" data-datatable-filter-clear="elevation">{{ "clear"|trans }}</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="filter-dropdown">
                            <button id="otherButton" data-dropdown="dropdownOther" data-dropdown-offset-distance="10" data-dropdown-offset-skidding="0" type="button">
                                <span>{{ "Other"|trans }}</span>
                                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
                                </svg>
                            </button>
                            <div id="dropdownOther">
                                <div class="px-1 py-2 flex gap-x-2 divide-x divide-gray-100">
                                    <div class="flex flex-col items-center">
                                        <div class="text-xs font-medium items-center">{{ "Description"|trans }}</div>
                                        <ul class="text-sm text-gray-700">
                                            <li>
                                                <div>
                                                    <input type="radio" id="hasDescription" data-dataTable-filter="hasDescription" name="hasDescription" value="with" class="peer" />
                                                    <label for="hasDescription">
                                                        {{ "With description"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="hasDescription">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                            <li>
                                                <div>
                                                    <input type="radio" id="hasDescription-none" data-dataTable-filter="hasDescription" name="hasDescription" value="without" class="peer" />
                                                    <label for="hasDescription-none">
                                                        {{ "Without description"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="hasDescription">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="flex flex-col items-center">
                                        <div class="text-xs font-medium items-center">{{ "Gallery"|trans }}</div>
                                        <ul class="text-sm text-gray-700">
                                            <li>
                                                <div>
                                                    <input type="radio" id="hasGallery" data-dataTable-filter="hasGallery" name="hasGallery" value="with" class="peer" />
                                                    <label for="hasGallery">
                                                        {{ "With gallery"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="hasGallery">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                            <li>
                                                <div>
                                                    <input type="radio" id="hasGallery-none" data-dataTable-filter="hasGallery" name="hasGallery" value="without" class="peer" />
                                                    <label for="hasGallery-none">
                                                        {{ "Without gallery"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="hasGallery">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="flex flex-col items-center">
                                        <div class="text-xs font-medium">{{ "Image"|trans }}</div>
                                        <ul class="text-sm text-gray-700">
                                            <li>
                                                <div>
                                                    <input type="radio" id="hasImage" data-dataTable-filter="hasImage" name="hasImage" value="with" class="peer" />
                                                    <label for="hasImage">
                                                        {{ "With image"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="hasImage">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                            <li>
                                                <div>
                                                    <input type="radio" id="hasImage-none" data-dataTable-filter="hasImage" name="hasImage" value="without" class="peer" />
                                                    <label for="hasImage-none">
                                                        {{ "Without image"|trans }}
                                                    </label>
                                                    <a href="#" data-datatable-filter-clear="hasImage">{{ "clear"|trans }}</a>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center justify-between gap-x-2 text-xs text-gray-700">
                        <div>
                            {% set numberOfResults = '<span class="font-bold" data-dataTable-result-count>' ~ totalCollectionCount ~ '</span>' %}
                            {{ "{numberOfResults} results"|trans({'{numberOfResults}': numberOfResults}) }}
                        </div>
                        <a href="#" class="hidden font-medium text-primary hover:underline" data-dataTable-reset>{{ "Clear all filters"|trans }}</a>
                    </div>
                </form>
                <table class="collections-table">
                    <tbody class="clusterize-content block">
                    <tr class="clusterize-loading">
                        <td class="block p-0">
                            <div class="flex justify-center py-10">
                                {% include 'html/loader.html.twig' with {modifier: 'loader--sm'} %}
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endautoescape %}
