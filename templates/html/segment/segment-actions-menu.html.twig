{% set isAdmin = isAuthenticated() %}
{% set canEditSegment = importMode.isFiles() and segment.getType().isCustom() %}
{% set hasWindAhead = segment.getWindAheadUrl() is not empty %}
{% if isAdmin or hasWindAhead %}
    <div class="relative shrink-0">
        <button id="segmentActionsButton"
                data-dropdown="segmentActionsDropdown"
                data-dropdown-placement="bottom-end"
                data-dropdown-offset-distance="6"
                type="button"
                class="inline-flex items-center gap-1.5 whitespace-nowrap text-xs font-medium text-gray-600 hover:text-gray-900 bg-white hover:bg-gray-50 border border-gray-200 shadow-xs rounded-lg px-3 py-1.5 transition">
            {{ svg('cog', 'size-3.5') }}
            {{ "Azioni"|trans({}, 'admin') }}
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
            </svg>
        </button>
        <div id="segmentActionsDropdown" class="hidden z-20 w-56 rounded-lg border border-gray-200 bg-white p-1 shadow-xl">
            {% if isAdmin %}
                <div class="flex items-center gap-1.5 px-2 pt-1.5 pb-1 text-[10px] font-semibold uppercase tracking-wider text-gray-400">
                    {{ svg('ruler', 'size-3') }}
                    {{ "Segmento"|trans({}, 'admin') }}
                </div>
                <ul aria-labelledby="segmentActionsButton">
                    {% if canEditSegment %}
                        <li>
                            <a href="{{ relativeUrlWithRedirectTo(path('admin_edit_segment', {segmentId: segment.getId()}), 'segments/' ~ segment.getId()) }}"
                               data-close-dropdown
                               class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">
                                {{ svg('pencil', 'size-3.5') }}
                                {{ "Modifica"|trans({}, 'admin') }}
                            </a>
                        </li>
                    {% endif %}
                    <li>
                        <a href="{{ relativeUrlWithRedirectTo(path('admin_local_segment_action', {segmentId: segment.getId(), action: 'generate'}), 'segments/' ~ segment.getId()) }}"
                           data-close-dropdown
                           class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">
                            {{ svg('route', 'size-3.5') }}
                            {{ "Ricalcola i dati"|trans({}, 'admin') }}
                        </a>
                    </li>
                </ul>
            {% endif %}

            {% if hasWindAhead %}
                <div class="mt-1 flex items-center gap-1.5 border-t border-gray-100 px-2 pt-2 pb-1 text-[10px] font-semibold uppercase tracking-wider text-gray-400">
                    {{ svg('windahead-logo', 'size-3') }}
                    {{ "Strumenti"|trans({}, 'admin') }}
                </div>
                <ul aria-labelledby="segmentActionsButton">
                    <li>
                        <a href="{{ segment.getWindAheadUrl() }}" target="_blank" rel="noopener"
                           data-close-dropdown
                           class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">
                            {{ svg('windahead-logo', 'size-3.5') }}
                            {{ "Apri in WindAhead"|trans({}, 'admin') }}
                        </a>
                    </li>
                </ul>
            {% endif %}
        </div>
    </div>
{% endif %}
