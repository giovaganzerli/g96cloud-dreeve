{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% set activityUrl = relativeUrl(path('activity', {activityId: activity.getId()})) %}
    <div class="modal-like-form">
        <div class="w-full max-w-lg overflow-y-auto p-6 bg-white border border-gray-200 rounded-lg shadow-xl">
            <div class="flex items-center justify-between gap-4 mb-4">
                <div class="flex items-center gap-3 min-w-0">
                    <span class="grid place-items-center size-10 shrink-0 rounded-lg bg-primary-soft text-primary" aria-hidden="true">
                        <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.5-4.5M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"/>
                        </svg>
                    </span>
                    <h3 class="text-lg font-semibold">Cerca segmenti locali</h3>
                </div>
                <a href="{{ activityUrl }}" aria-label="Chiudi" title="Chiudi"
                   class="grid place-items-center size-8 shrink-0 rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900">
                    <svg class="size-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 6 12 12M6 18 18 6"/>
                    </svg>
                </a>
            </div>
            <form data-dispatch-command="{{ dispatchCommand }}" class="flex flex-col gap-4">
                <input type="hidden" name="activityId" value="{{ activity.getId() }}">
                <div data-form-error class="form-error hidden" role="alert"></div>
                <div class="flex items-center gap-3 rounded-lg bg-gray-50 p-3">
                    <span class="shrink-0 text-primary" aria-hidden="true">{{ svgSportType(activity.getSportType(), 'size-5') }}</span>
                    <p class="min-w-0 text-sm font-semibold text-gray-900">{{ activity.getName() }}</p>
                </div>
                <div class="space-y-4 text-sm text-gray-600">
                    <div class="flex items-start gap-3">
                        <svg class="size-5 shrink-0 text-primary" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h12a4 4 0 0 1 0 8H7m0 0 3-3m-3 3 3 3M7 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm14 14a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"/>
                        </svg>
                        <div class="min-w-0 space-y-1">
                            <p class="font-medium text-gray-900">Ricerca sui segmenti locali</p>
                            <p>Include i segmenti importati da Strava con una traccia GPS disponibile.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <svg class="size-5 shrink-0 text-primary" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Zm-4 9 3 3 5-6"/>
                        </svg>
                        <div class="min-w-0 space-y-1">
                            <p class="font-medium text-gray-900">Passaggi già presenti conservati</p>
                            <p>Puoi ripetere la ricerca quando aggiungi nuovi segmenti.</p>
                        </div>
                    </div>
                </div>
                <div class="flex flex-wrap items-center justify-end gap-2 border-t border-gray-200 pt-4">
                    <a href="{{ activityUrl }}" type="button" class="btn--secondary">
                        <svg class="size-4 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m0 0 6-6m-6 6 6 6"/>
                        </svg>
                        Torna all’attività
                    </a>
                    <button type="submit" data-has-loading-state class="group btn--primary">
                        <span class="label">
                            <span class="inline-flex items-center gap-2">
                                <svg class="size-4 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.5-4.5M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"/>
                                </svg>
                                Cerca segmenti
                            </span>
                        </span>
                        <span class="label--loading">
                            <span class="inline-flex items-center gap-2">
                                <svg class="size-4 shrink-0 animate-spin" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12a8 8 0 1 1-8-8m0 0h5m-5 0v5"/>
                                </svg>
                                Ricerca in corso...
                            </span>
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock main %}
