{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% set segmentUrl = relativeUrl(path('segment', {segmentId: segment.getId()})) %}
    {% set hasTrack = segment.getPolyline() is not null %}
    <div class="modal-like-form">
        <div class="w-full max-w-lg overflow-y-auto p-6 bg-white border border-gray-200 rounded-lg shadow-xl">
            <div class="flex items-center justify-between gap-4 mb-4">
                <div class="flex items-center gap-3 min-w-0">
                    <span class="grid place-items-center size-10 shrink-0 rounded-lg bg-primary-soft text-primary" aria-hidden="true">{{ svg('route', 'size-5') }}</span>
                    <h3 class="text-lg font-semibold">Genera traccia</h3>
                </div>
                <a href="{{ segmentUrl }}" aria-label="Chiudi" title="Chiudi" class="grid place-items-center size-8 shrink-0 rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900">{{ svg('close', 'size-5') }}</a>
            </div>
            <div class="flex items-center gap-3 rounded-lg bg-gray-50 p-3 mb-4">
                <span class="shrink-0 text-primary" aria-hidden="true">{{ svgSportType(segment.getSportType(), 'size-5') }}</span>
                <p class="min-w-0 text-sm font-semibold text-gray-900">{{ segment.getName() }}</p>
            </div>
            <div class="space-y-4">
                <form data-dispatch-command="{{ dispatchCommand }}" class="rounded-lg border border-gray-200 p-4 space-y-3">
                    <input type="hidden" name="segmentId" value="{{ segment.getId() }}">
                    <input type="hidden" name="action" value="search">
                    <div class="flex items-start gap-3">
                        <span class="shrink-0 text-primary" aria-hidden="true">{{ svg('search', 'size-5') }}</span>
                        <div class="min-w-0 space-y-1">
                            <h4 class="text-sm font-semibold text-gray-900">Cerca nelle attività</h4>
                            <p class="text-sm text-gray-600">{{ hasTrack
                                ? 'Trova i passaggi su questo segmento tra le attività GPS salvate in Dreeve.'
                                : 'Ricostruisci la traccia dai passaggi GPS archiviati e cerca le attività su questo segmento.' }}</p>
                        </div>
                    </div>
                    <div data-form-error class="form-error hidden" role="alert"></div>
                    <div class="flex justify-end">
                        <button type="submit" data-has-loading-state class="group btn--primary">
                            <span class="label"><span class="inline-flex items-center gap-2">{{ svg('search', 'size-4') }} Cerca attività</span></span>
                            <span class="label--loading">Ricerca in corso...</span>
                        </button>
                    </div>
                </form>
                {% if not hasTrack %}
                    <div class="flex items-center gap-3 text-xs text-gray-500">
                        <span class="flex-1 border-t border-gray-200"></span>
                        <span>oppure</span>
                        <span class="flex-1 border-t border-gray-200"></span>
                    </div>
                    <form method="post" enctype="multipart/form-data" action="{{ relativeUrl(path('admin_local_segment_action', {segmentId: segment.getId(), action: 'upload'})) }}" class="rounded-lg border border-gray-200 p-4 space-y-3">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('dispatch-command') }}">
                        <div class="flex items-start gap-3">
                            <span class="shrink-0 text-primary" aria-hidden="true">{{ svg('upload', 'size-5') }}</span>
                            <div class="min-w-0 space-y-1">
                                <h4 class="text-sm font-semibold text-gray-900">Carica un GPX</h4>
                                <p class="text-sm text-gray-600">Usa il file del solo segmento, anche senza orari. Dimensione massima: 5 MB.</p>
                            </div>
                        </div>
                        {% if error %}<div class="form-error" role="alert">{{ error }}</div>{% endif %}
                        <div>
                            <label for="segment-track" class="sr-only">Traccia GPX del segmento</label>
                            <input type="file" id="segment-track" name="track" accept=".gpx,application/gpx+xml" required>
                        </div>
                        <label class="flex items-start gap-3 rounded-lg bg-gray-50 p-3 text-sm text-gray-600">
                            <input type="checkbox" name="recalculate" value="1" required class="mt-1 shrink-0">
                            <span>Confermo che questo è il GPX del solo segmento. Lunghezza e dislivello saranno ricavati dal file, anche se diversi dai dati Strava. I risultati precedenti verranno archiviati e ricalcolati dalle attività GPS disponibili; tempi, velocità e classifiche potrebbero cambiare. Senza quote nel GPX, dislivello e pendenze non saranno disponibili.</span>
                        </label>
                        <div class="flex justify-end">
                            <button type="submit" data-has-loading-state class="group btn--primary">
                                <span class="label"><span class="inline-flex items-center gap-2">{{ svg('upload', 'size-4') }} Carica GPX</span></span>
                                <span class="label--loading">Caricamento in corso...</span>
                            </button>
                        </div>
                    </form>
                {% else %}
                    <div class="flex items-center gap-3 text-sm text-gray-500">
                        <span class="shrink-0 text-primary" aria-hidden="true">{{ svg('route', 'size-5') }}</span>
                        <p>La traccia GPS è già disponibile e viene conservata.</p>
                    </div>
                    {% if error %}<div class="form-error" role="alert">{{ error }}</div>{% endif %}
                {% endif %}
            </div>
            <div class="flex justify-end border-t border-gray-200 pt-4 mt-4">
                <a href="{{ segmentUrl }}" type="button" class="btn--secondary">{{ svg('arrow-left', 'size-4') }} Torna al segmento</a>
            </div>
        </div>
    </div>
{% endblock main %}
