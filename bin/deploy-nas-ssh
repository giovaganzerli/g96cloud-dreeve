#!/usr/bin/env bash
# Forced command for the dedicated deployment SSH key. Never eval remote input.
set -euo pipefail
if [[ ${SSH_ORIGINAL_COMMAND:-} =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
    exec sudo -n /usr/local/sbin/dreeve-deploy "${BASH_REMATCH[1]}"
fi
echo 'Only deploy <commit-sha> is allowed.' >&2
exit 1
